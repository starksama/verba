# Release signing for maintainers. Copy to .env (gitignored) and fill in.
# Contributors don't need this: `npm run setup:macos-signing` creates a local
# certificate and builds sign with it by default.

# From `security find-identity -v -p codesigning`.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# App Store Connect API key for notarization (Users and Access > Integrations).
# APPLE_API_KEY_PATH points at the .p8 file; keep that file outside the repo.
APPLE_API_KEY=
APPLE_API_ISSUER=
APPLE_API_KEY_PATH=
